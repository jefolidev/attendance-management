// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  ADMIN
  EMPLOYEE
}

model Employee {
  id       String @id @default(cuid())
  username String @unique
  password String

  role Role @default(EMPLOYEE)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  timeEntries        TimeEntry[]
  timeBalanceEntries TimeBalanceEntry[]
  timeEntryJustifications TimeEntryJustification[] @relation("employee_time_entry_justifications")
  approvedTimeEntryJustifications TimeEntryJustification[] @relation("approved_time_entry_justifications")

  workSchedule WorkSchedule?
  timeBalance  TimeBalance?

  @@map("employees")
}

enum TimeBalanceEntryType {
  CREDIT
  DEBIT
}

enum TimeBalanceEntryReason {
  LATE_ARRIVAL
  EARLY_DEPARTURE
  OVERTIME
  COMPENSATION
  EXTRA
  MANUAL_ADJUSTMENT
}

model TimeBalanceEntry {
  id String @id @default(cuid())

  type   TimeBalanceEntryType
  reason TimeBalanceEntryReason

  durationInMinutes Int @map("duration_in_minutes")

  createdAt DateTime @default(now()) @map("created_at")

  employeeId String @map("employee_id")

  timeBalanceId String? @map("time_balance_id")

  employee    Employee     @relation(fields: [employeeId], references: [id])
  timeBalance TimeBalance? @relation(fields: [timeBalanceId], references: [id])

  @@map("time_balance_entries")
}

model TimeBalance {
  id String @id @default(cuid())

  events         TimeBalanceEntry[]
  balanceMinutes Int                @map("balance_minutes")

  updatedAt DateTime? @updatedAt @map("updated_at")

  employeeId String   @unique @map("employee_id")
  employee   Employee @relation(fields: [employeeId], references: [id])

  @@map("time_balances")
}

enum TimeEntryStage {
  CLOCKED_IN
  CLOCKED_OUT
  ON_BREAK
}

model TimeEntry {
  id String @id @default(cuid())

  clockIn  DateTime  @map("clock_in")
  clockOut DateTime? @map("clock_out")

  breaks Json
  status TimeEntryStage

  updatedAt DateTime? @updatedAt @map("updated_at")

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  justifications TimeEntryJustification[] @relation("time_entry_justifications")

  @@map("time-entry")
}

enum TimeEntryJustificationType {
  LATE_ARRIVAL
  EARLY_DEPARTURE
}

enum TimeEntryJustificationCategory {
  MEDICAL_EMERGENCY
}

model TimeEntryJustification {
  id String @id @default(cuid())

  type     TimeEntryJustificationType
  category TimeEntryJustificationCategory
  description String?

  createdAt DateTime @default(now()) @map("created_at")

  employeeId  String @map("employee_id")
  timeEntryId String @map("time_entry_id")
  approvedById String @map("approved_by_id")

  employee  Employee  @relation("employee_time_entry_justifications", fields: [employeeId], references: [id])
  timeEntry TimeEntry  @relation("time_entry_justifications", fields: [timeEntryId], references: [id], onDelete: Cascade)
  approvedBy Employee @relation("approved_time_entry_justifications", fields: [approvedById], references: [id])

  @@unique([timeEntryId, type])
  @@index([employeeId])
  @@map("time_entry_justifications")
}

model WorkDays {
  id Int @id @default(autoincrement())

  monday    Boolean
  tuesday   Boolean
  wednesday Boolean
  thursday  Boolean
  friday    Boolean
  saturday  Boolean
  sunday    Boolean

  workDaysWorkSchedules WorkDaysWorkSchedule[]

  @@map("work-days")
}

model WorkDaysWorkSchedule {
  workDaysId     Int          @map("work_days_id")
  workScheduleId String       @map("work_schedule_id")
  workDays       WorkDays     @relation(fields: [workDaysId], references: [id])
  workSchedule   WorkSchedule @relation(fields: [workScheduleId], references: [id])

  @@id([workDaysId, workScheduleId])
  @@map("work-days-work-schedule")
}

model WorkSchedule {
  id String @id @default(cuid())

  startTime String @map("start_time")
  endTime   String @map("end_time")

  breakStartTime String? @map("break_start_time")
  breakEndTime   String? @map("break_end_time")

  lateTolerance Int @map("late_tolerance")

  breaksPerDay Int @map("breaks_per_day")

  employeeId String   @unique
  employee   Employee @relation(fields: [employeeId], references: [id])

  workDaysWorkSchedules WorkDaysWorkSchedule[]
  dayOverrides WorkScheduleDayOverride[]

  @@map("work-schedule")
}

model WorkScheduleDayOverride {
  id String @id @default(cuid())

  workScheduleId String @map("work_schedule_id")
  dayOfWeek     Int    @map("day_of_week")
  startTime     String? @map("start_time")
  endTime       String? @map("end_time")

  workSchedule WorkSchedule @relation(fields: [workScheduleId], references: [id], onDelete: Cascade)

  @@unique([workScheduleId, dayOfWeek])
  @@map("work-schedule-day-override")
}
